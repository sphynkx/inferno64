# sh initialisation here
load std

host = `{cat /env/emuhost}
user = `{cat /dev/user}
home = /usr/^$user
local = /n/local
and {~ $host Linux} {
	user = inferno
	home = /usr/inferno
	path = (/dis $local .)
}
bind -c '#U*'^$emuwdir $local
and {! ~ $host Linux} {bind -a '#U*'/home /usr}
and {~ $host Linux} {cd $emuwdir}
and {! ~ $host Linux} {cd $local}
and {ftest -e namespace}	{nsbuild}
#cd $home
font=/fonts/pelm/unicode.8.font

# build any namespace in cwd
and {ftest -e $home/namespace}	{nsbuild $home/namespace}

# Run the local profile
and {ftest -e lib/profile}	{run ./lib/profile}
